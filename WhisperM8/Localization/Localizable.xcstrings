          "stringUnit": {
            "state": "translated",
            "value": "Konversation ist leer"
          }
        }
      }
    },
    "Couldn't save the key to the macOS Keychain. Unlock your Keychain and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Key konnte nicht im macOS-Schlüsselbund gespeichert werden. Entsperre den Schlüsselbund und versuche es erneut."
