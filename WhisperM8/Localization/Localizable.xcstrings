    "Cancelled — chats already moved stay in the target account.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgebrochen — die bereits verschobenen Chats bleiben im Zielkonto."
          }
        }
      }
    },
    "Cancelling takes effect after the current chat — a transcript is never moved halfway.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Abbruch wirkt nach dem aktuellen Chat — ein Transcript wird nie halb verschoben."
