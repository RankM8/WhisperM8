            "value": "Alles bereit!"
          }
        }
      }
    },
    "All stored entries are deleted, pinned ones too. This cannot be undone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle gespeicherten Einträge werden gelöscht, auch angepinnte. Das lässt sich nicht rückgängig machen."
          }
        }
      }
