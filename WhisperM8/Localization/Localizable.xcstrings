          }
        }
      }
    },
    "Allow Accessibility for WhisperM8 first": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erst Bedienungshilfen für WhisperM8 erlauben"
          }
        }
