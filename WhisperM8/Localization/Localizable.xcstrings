    },
    "Agent overview — Claude’s dashboard of all sessions. WhisperM8 cannot tell which sub-chat is active inside the TUI.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent-Übersicht — Claudes Dashboard aller Sessions. Welcher Sub-Chat in der TUI gerade aktiv ist, kann WhisperM8 nicht erkennen."
