    "%@ API value against %@ in subscription costs (%@ per month, prorated for the period).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ API-Gegenwert stehen %@ Abo-Kosten gegenüber (%@ im Monat, anteilig für den Zeitraum)."
