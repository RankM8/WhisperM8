    "Carrier word": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trägerwort"
          }
        }
      }
    },
    "Carrier word plus command, spoken together after a short pause. The carrier alone never triggers anything — it comes up in normal conversation too often.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trägerwort plus Kommando, zusammen nach einer kurzen Pause gesprochen. Das Trägerwort allein löst nie etwas aus – es fällt in normalen Gesprächen zu oft."
          }
        }
      }
    },
    "Cautious Fallback": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorsichtiger Rückfall"
          }
        }
      }
    },
    "Changes apply to the next recording. Bluetooth devices may fall back to System Default.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen gelten ab der nächsten Aufnahme. Bluetooth-Geräte können auf den Systemstandard zurückfallen."
          }
        }
      }
    },
    "Chat actions": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat-Aktionen"
          }
        }
      }
    },
    "Chat can’t be selected here (e.g. tab in another window)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat ist hier nicht anwählbar (z. B. Tab in einem anderen Fenster)"
          }
        }
      }
    },
    "Chat history currently not found: for session %@ there is no transcript file under ~/.claude/projects or in any account profile (~/.claude-profiles/*/projects). If it was deleted, start a new chat for new work — this tab keeps its assignment and resumes automatically as soon as the file reappears.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat-Verlauf momentan nicht auffindbar: Für Session %@ existiert weder unter ~/.claude/projects noch in einem Account-Profil (~/.claude-profiles/*/projects) eine Transcript-Datei. Falls sie gelöscht wurde, lege für neue Arbeit einen neuen Chat an — dieser Tab behält seine Zuordnung und resumed automatisch wieder, sobald die Datei wieder auftaucht."
          }
        }
      }
    },
