    "%lld config(s) contain a different status line command. Replacing switches both entries to the WhisperM8 status lines.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Konfiguration(en) enthalten einen anderen Statuszeilen-Befehl. Ersetzen stellt beide Einträge auf die WhisperM8-Statuszeilen um."
          }
        }
      }
    },
    "%lld config(s) use a different status line command.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Konfiguration(en) nutzen einen anderen Statuszeilen-Befehl."
