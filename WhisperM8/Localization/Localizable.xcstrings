    "Stopping only ends proxy processes started by WhisperM8 itself — the main proxy and the instances of the additional accounts.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppen beendet nur von WhisperM8 selbst gestartete Proxy-Prozesse — den Hauptproxy und die Instanzen der Zusatzkonten."
          }
