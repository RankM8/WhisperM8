    "%lld of %lld chats are still running — archiving ends the terminals. All chats stay in the archive and can be restored.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld von %2$lld Chats laufen noch — beim Archivieren werden die Terminals beendet. Alle Chats bleiben im Archiv erhalten und lassen sich wiederherstellen."
          }
        }
      }
    },
    "%lld of %lld chats are still running — ending stops the terminals and closes the tabs. Nothing is archived; all chats can be resumed via “Recent”.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld von %2$lld Chats laufen noch — beim Beenden werden die Terminals gestoppt und die Tabs geschlossen. Nichts wird archiviert; alle Chats lassen sich über „Zuletzt“ fortsetzen."
