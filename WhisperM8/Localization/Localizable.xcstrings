          }
        }
      }
    },
    "Swiping sideways on the trackpad moves to the next or previous tab. Ignored for a moment after you type, so a resting palm cannot switch chats while you write.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seitliches Wischen auf dem Trackpad wechselt zum nächsten oder vorherigen Tab. Direkt nach dem Tippen wird es kurz ignoriert, damit eine aufliegende Handfläche beim Schreiben keinen Chat wechselt."
          }
        }
      }
    },
    "Switch tabs with a two-finger swipe": {
      "localizations": {
