{
  "sourceLanguage": "en",
  "strings": {
    "%@ at the top starts %@ again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ oben startet %2$@ erneut."
          }
        }
      }
    },
    "%@ deleted the saved history of this chat.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat den gespeicherten Verlauf dieses Chats gelöscht."
          }
        }
      }
    },
    "%@ is installed": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist installiert"
          }
        }
      }
    },
    "%@ is not installed yet": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist noch nicht installiert"
          }
        }
      }
    },
    "%lld chats are still working": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Chats arbeiten noch"
          }
        }
      }
    },
    "%lld of them are still running and will be stopped.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld davon laufen noch und werden beendet."
          }
        }
      }
    },
    "A chat is still working": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Chat arbeitet noch"
          }
        }
      }
    },
    "AI enrichment modes (Clean, Email, Slack …) use the Codex CLI with your ChatGPT login. This is optional — you can skip it now and connect later in Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI-Modi (Bereinigen, E-Mail, Slack …) nutzen die Codex-CLI mit deinem ChatGPT-Login. Das ist optional – du kannst es jetzt überspringen und später in den Einstellungen verbinden."
          }
        }
      }
    },
    "Accessibility": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedienungshilfen"
          }
        }
      }
    },
    "Add a project folder to start a chat": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge einen Projektordner hinzu, um einen Chat zu starten"
          }
        }
      }
    },
    "Add a project folder, then start a chat with Claude or Codex there.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge einen Projektordner hinzu und starte dort einen Chat mit Claude oder Codex."
          }
        }
      }
    },
    "Add project…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Projekt hinzufügen…"
          }
        }
      }
    },
    "Agent Chats run the Claude Code command line tool. This is optional — you can skip it now and install it later.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent Chats nutzen das Kommandozeilen-Tool Claude Code. Das ist optional – du kannst es jetzt überspringen und später installieren."
          }
        }
      }
    },
    "All permissions granted!": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Berechtigungen erteilt!"
          }
        }
      }
    },
    "All set!": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles bereit!"
          }
        }
      }
    },
    "Also removes the paste copies and keeps no image or video copies in the output archive. Text and metadata of a run stay in the archive.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt zusätzlich die Einfüge-Kopien und legt im Ausgabe-Archiv keine Bild- oder Videokopien ab. Text und Metadaten eines Laufs bleiben im Archiv."
          }
        }
      }
    },
    "App Permissions": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App-Berechtigungen"
          }
        }
      }
    },
    "Auto-detect": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch erkennen"
          }
        }
      }
    },
    "Auto-paste or clipboard": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch einfügen oder in die Zwischenablage"
          }
        }
      }
    },
    "Auto-paste text": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Text automatisch einfügen"
          }
        }
      }
    },
    "Auto-paste text into other apps": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Text automatisch in andere Apps einfügen"
          }
        }
      }
    },
    "Back": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zurück"
          }
        }
      }
    },
    "Background agent was not fully spawned": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hintergrund-Agent unvollständig gespawnt"
          }
        }
      }
    },
    "Background agent was not fully started": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hintergrund-Agent wurde nicht vollständig gestartet"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbrechen"
          }
        }
      }
    },
    "Chats run the real Claude Code CLI. If you prefer Anthropic's own installer, follow the official instructions and then check again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Chats nutzen die echte Claude-Code-CLI. Wenn du den Installer von Anthropic bevorzugst, folge der offiziellen Anleitung und prüfe danach erneut."
          }
        }
      }
    },
    "Check Again": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erneut prüfen"
          }
        }
      }
    },
    "Click **%@** at the top of the header to start %@ and continue this session.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klick oben in der Kopfzeile auf **%1$@**, um %2$@ zu starten und mit dieser Session weiterzumachen."
          }
        }
      }
    },
    "Click Save Key to store it in your Keychain.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf „Key speichern“, um ihn im Schlüsselbund abzulegen."
          }
        }
      }
    },
    "Click each button to grant permission": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke jeden Button, um die Berechtigung zu erteilen"
          }
        }
      }
    },
    "Close": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließen"
          }
        }
      }
    },
    "Close tab — the chat keeps running in the background": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab schließen — der Chat läuft im Hintergrund weiter"
          }
        }
      }
    },
    "Closing a tab does not stop the chat. It keeps working in the background. To stop it, use End or Archive in the sidebar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Schließen eines Tabs beendet den Chat nicht. Er arbeitet im Hintergrund weiter. Zum Beenden in der Seitenleiste „Beenden“ oder „Archivieren“ nutzen."
          }
        }
      }
    },
    "Configuration": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfiguration"
          }
        }
      }
    },
    "Configure Hotkey": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastenkürzel festlegen"
          }
        }
      }
    },
    "Connect Codex (optional)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex verbinden (optional)"
          }
        }
      }
    },
    "Continue Setup…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setup fortsetzen …"
          }
