          }
        }
      }
    },
    "Close tab of %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab von %@ schließen"
          }
        }
      }
    },
    "Close tab — the chat keeps running in the background": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab schließen — der Chat läuft im Hintergrund weiter"
          }
        }
      }
    },
    "Close tab — the chat leaves the project view (if it is still running, it stays as an active member)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab schließen — der Chat verlässt die Projekt-Ansicht (läuft er noch, bleibt er als aktives Mitglied)"
          }
        }
      }
    },
    "Close tab, end chat and remove from workspace": {
