{
  "sourceLanguage": "en",
  "strings": {
    " Last automatic attempt: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Letzter automatischer Versuch: %@"
          }
        }
      }
    },
    " The chat is also removed from the workspace “%@”.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Der Chat wird außerdem aus dem Workspace „%@“ entfernt."
          }
        }
      }
    },
    " · free from %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " · frei ab %@"
          }
        }
      }
    },
    "%@ (active)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (aktiv)"
          }
        }
      }
    },
    "%@ (not in catalog)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (nicht im Katalog)"
          }
        }
      }
    },
    "%@ (not signed in)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (nicht eingeloggt)"
          }
        }
      }
    },
    "%@ API key...": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-API-Key..."
          }
        }
      }
    },
    "%@ Showing Raw fallback.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Es wird der Rohtext-Rückfall angezeigt."
          }
        }
      }
    },
    "%@ ago": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "vor %@"
          }
        }
      }
    },
    "%@ at the top starts %@ again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ oben startet %2$@ erneut."
          }
        }
      }
    },
    "%@ deleted the saved history of this chat.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat den gespeicherten Verlauf dieses Chats gelöscht."
          }
        }
      }
    },
    "%@ extra arguments": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zusätzliche Argumente für %@"
          }
        }
      }
    },
    "%@ has not approved the folder yet: Claude asks on start — choose “Yes, I trust this folder” there (“No, exit” is preselected). Affects: %@%@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat den Ordner noch nicht freigegeben: Claude fragt beim Start nach — dort „Yes, I trust this folder“ wählen (vorausgewählt ist „No, exit“). Betrifft: %2$@%3$@"
          }
        }
      }
    },
    "%@ is installed": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist installiert"
          }
        }
      }
    },
    "%@ is not in your Codex CLI's model list (%@). If runs fail, pick a listed model or update the Codex CLI.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ steht nicht in der Modellliste deiner Codex CLI (%@). Falls Läufe fehlschlagen, wähle ein gelistetes Modell oder aktualisiere die Codex CLI."
          }
        }
      }
    },
    "%@ is not installed yet": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist noch nicht installiert"
          }
        }
      }
    },
    "%@ is not listed for %@ (%@) — Codex may reject or downgrade it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist für %@ nicht gelistet (%@) – Codex lehnt es womöglich ab oder stuft es herab."
          }
        }
      }
    },
    "%@ is not listed for %@ — Codex may reject or downgrade it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist für %@ nicht gelistet – Codex lehnt es womöglich ab oder stuft es herab."
          }
        }
      }
    },
    "%@ turns off the agent's permission prompts for every chat. Remove it unless you know exactly why you need it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ schaltet die Freigabe-Rückfragen des Agents für jeden Chat ab. Entferne es, außer du weißt genau, wofür du es brauchst."
          }
        }
      }
    },
    "%@ — click: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — Klick: %2$@"
          }
        }
      }
    },
    "%@ — leaves the workspace": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — verlässt den Workspace"
          }
        }
      }
    },
    "%@ — stays in the workspace": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — bleibt im Workspace"
