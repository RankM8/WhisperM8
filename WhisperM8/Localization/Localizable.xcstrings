    "Uses Account default: %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutzt den Standard des Kontos: %@."
          }
        }
      }
    },
    "Uses Codex standard routing and avoids the Fast-mode credit multiplier.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutzt das Standard-Routing von Codex und vermeidet den Credit-Faktor des Fast-Modus."
          }
        }
      }
    },
    "Uses defaultMode from the project settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutzt defaultMode aus den Settings des Projekts."
          }
        }
      }
    },
    "Uses the official Codex CLI login. This is separate from the OpenAI transcription API key.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutzt die offizielle Anmeldung der Codex CLI. Sie ist unabhängig vom OpenAI-API-Schlüssel für die Transkription."
          }
        }
      }
    },
    "Uses the same Keychain API key as the app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutzt denselben API-Schlüssel aus dem Schlüsselbund wie die App."
          }
        }
      }
    },
    "Uses the stable Codex CLI image path today, and can switch to direct video when the CLI exposes it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutzt derzeit den stabilen Bildpfad der Codex CLI und kann auf direktes Video umschalten, sobald die CLI es anbietet."
          }
        }
      }
    },
    "Uses the title the CLI already has — Claude's /rename or generated title, otherwise the first prompt. No extra model call. A name you set in WhisperM8 wins until you reset it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übernimmt den Titel, den die CLI schon hat – Claudes /rename oder den erzeugten Titel, sonst den ersten Prompt. Kein zusätzlicher Modellaufruf. Ein Name, den du in WhisperM8 vergibst, gilt, bis du ihn zurücksetzt."
          }
        }
      }
    },
