  "strings": {
    " Last automatic attempt: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Letzter automatischer Versuch: %@"
          }
        }
      }
    },
    " · free from %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " · frei ab %@"
          }
        }
      }
    },
