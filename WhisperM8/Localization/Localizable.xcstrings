        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird installiert …"
          }
        }
      }
    },
    "It is still running. Removing it stops the agent and deletes it from the supervisor.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er läuft noch. Beim Entfernen wird der Agent gestoppt und vom Supervisor gelöscht."
          }
        }
      }
    },
    "Last entry is too large for the preview": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Letzter Eintrag zu groß für die Vorschau"
          }
        }
      }
    },
    "Microphone": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon"
          }
        }
      }
    },
    "Microphone access is restricted on this Mac (for example by a profile or Screen Time). Ask your administrator or change it in System Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mikrofonzugriff ist auf diesem Mac eingeschränkt (z. B. durch ein Profil oder Bildschirmzeit). Frage deinen Administrator oder ändere es in den Systemeinstellungen."
          }
        }
      }
    },
    "Microphone access was denied. Turn on WhisperM8 under Privacy & Security → Microphone, then come back here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mikrofonzugriff wurde abgelehnt. Aktiviere WhisperM8 unter Datenschutz & Sicherheit → Mikrofon und komm dann hierher zurück."
          }
        }
      }
    },
    "Model": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modell"
          }
        }
      }
    },
    "Native macOS dictation app with best-in-class transcription.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Native macOS-Diktier-App mit erstklassiger Transkription."
          }
        }
      }
    },
