    },
    "Fast stays visible as the fallback mode.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast bleibt als Rückfallmodus sichtbar."
          }
        }
      }
    },
    "Faster in theory, but text can look softer. Takes effect after restarting WhisperM8.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Theorie schneller, aber Text kann weicher aussehen. Wirkt nach einem Neustart von WhisperM8."
