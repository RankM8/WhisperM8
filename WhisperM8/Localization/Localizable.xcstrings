{
  "sourceLanguage": "en",
  "strings": {
    "%@ at the top starts %@ again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ oben startet %2$@ erneut."
          }
        }
      }
    },
    "%@ deleted the saved history of this chat.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat den gespeicherten Verlauf dieses Chats gelöscht."
          }
        }
      }
    },
    "Add a project folder to start a chat": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge einen Projektordner hinzu, um einen Chat zu starten"
          }
        }
      }
    },
    "Add a project folder, then start a chat with Claude or Codex there.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge einen Projektordner hinzu und starte dort einen Chat mit Claude oder Codex."
          }
        }
      }
    },
    "Add project…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Projekt hinzufügen…"
          }
        }
      }
    },
    "Background agent was not fully spawned": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hintergrund-Agent unvollständig gespawnt"
          }
        }
      }
    },
    "Background agent was not fully started": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hintergrund-Agent wurde nicht vollständig gestartet"
          }
        }
      }
    },
    "Click **%@** at the top of the header to start %@ and continue this session.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klick oben in der Kopfzeile auf **%1$@**, um %2$@ zu starten und mit dieser Session weiterzumachen."
          }
        }
      }
    },
    "Conversation is empty": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konversation ist leer"
          }
        }
      }
    },
    "Details": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Details"
          }
        }
      }
    },
    "History deleted, can't be continued": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlauf gelöscht, nicht fortsetzbar"
          }
        }
      }
    },
    "History no longer available": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlauf nicht mehr vorhanden"
          }
        }
      }
    },
    "Last entry is too large for the preview": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Letzter Eintrag zu groß für die Vorschau"
          }
        }
      }
    },
    "New chat": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neuer Chat"
          }
        }
      }
    },
    "No agent chat": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Agent Chat"
          }
        }
      }
    },
    "No chat selected": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Chat ausgewählt"
          }
        }
      }
    },
    "No project found": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Projekt gefunden"
          }
        }
      }
    },
    "No projects yet": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Projekte"
          }
        }
      }
    },
    "Older messages are available": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ältere Nachrichten sind vorhanden"
          }
        }
      }
    },
    "Session ID: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Session-ID: %@"
          }
        }
      }
    },
    "Session not started yet": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Session noch nicht gestartet"
          }
        }
      }
    },
    "Spawning this background agent was interrupted, so no short ID was saved. Close the tab from the context menu and start a new background agent if needed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Spawn dieses Hintergrund-Agents wurde unterbrochen, sodass keine Short-ID gespeichert ist. Schließe den Tab über das Kontextmenü und starte bei Bedarf einen neuen Hintergrund-Agent."
          }
        }
      }
    },
    "Start a **New chat** in the same project to keep working there. You can archive this chat from its context menu in the sidebar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte einen **Neuen Chat** im selben Projekt, um dort weiterzuarbeiten. Diesen Chat kannst du über sein Kontextmenü in der Seitenleiste archivieren."
          }
        }
      }
    },
    "Start a new chat or pick one from the sidebar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte einen neuen Chat oder wähle einen in der Seitenleiste."
          }
        }
      }
    },
    "The last entry (for example a large tool result) doesn't fit into the preview. Use **Load earlier history** at the top to see the messages before it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der letzte Eintrag (z. B. ein großes Tool-Ergebnis) passt nicht ins Vorschaufenster. Über **Früheren Verlauf laden** oben erscheinen die Nachrichten davor."
          }
        }
      }
    },
    "This background session has no short ID, so it can't be attached. Close the tab or start it again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Hintergrund-Session hat keine Short-ID — Attach ist nicht möglich. Tab schließen oder neu starten."
          }
        }
      }
    },
    "This chat can't be continued": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Chat lässt sich nicht fortsetzen"
          }
        }
      }
    },
    "This conversation has no messages yet": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Konversation enthält noch keine Nachrichten"
          }
        }
      }
    },
    "This session has no conversation yet": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Session hat noch keine Konversation"
          }
        }
      }
    }
  },
  "version": "1.0"
}
