    "Launches Claude with a temporary --settings file that links the chat to its session. Your global ~/.claude/settings.json is never touched. Running sessions need a restart to pick up changes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet Claude mit einer temporären --settings-Datei, die den Chat mit seiner Sitzung verknüpft. Deine globale ~/.claude/settings.json wird nie angefasst. Laufende Sitzungen brauchen einen Neustart, um Änderungen zu übernehmen."
          }
        }
      }
    },
