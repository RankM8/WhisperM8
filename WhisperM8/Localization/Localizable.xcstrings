    "Claude Agents opens the multi-session dashboard view instead of a single chat.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Agents öffnet die Dashboard-Ansicht mit mehreren Sitzungen statt eines einzelnen Chats."
          }
        }
      }
    },
    "Claude CLI not found — install Claude Code first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude CLI nicht gefunden. Installiere zuerst Claude Code."
          }
        }
      }
    },
    "Claude CLI · extra arguments": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude-CLI · zusätzliche Argumente"
          }
